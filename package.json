{
  "name": "@cbhdyl/dsh-test-observatory",
  "description": "Test Observatory for DeepSeek Harness: the /test command, the run_tests tool, human-simulation browser journeys with screenshots, and a self-contained HTML quality report",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CBHDYL/dsh-test-observatory.git"
  },
  "homepage": "https://github.com/CBHDYL/dsh-test-observatory#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "testing",
    "test-report",
    "playwright",
    "accessibility",
    "axe-core"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./command": {
      "types": "./lib/types/command/index.d.ts",
      "default": "./lib/command/index.js"
    },
    "./tool": {
      "types": "./lib/types/tool/index.d.ts",
      "default": "./lib/tool/index.js"
    },
    "./report": {
      "types": "./lib/types/report/index.d.ts",
      "default": "./lib/report/index.js"
    },
    "./experience": {
      "types": "./lib/types/experience/index.d.ts",
      "default": "./lib/experience/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "playwright-core": "^1.61.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.0-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-alpha.1"
  },
  "engines": {
    "dsh": ">=0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.0-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-alpha.1",
    "@types/node": "^22.20.0",
    "jsdom": "^28.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
